# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=robtic_staff

# --- Staff system ---
# Any IANA timezone. Used for daily/weekly/monthly point boundaries and for the
# !stats / !leaderboard statistics windows. Weeks always start on Monday.
STAFF_TIMEZONE=UTC

# --- Discord (needed for the gateway client + command registration) ---
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register slash commands instantly to a single guild while developing.
DISCORD_DEV_GUILD_ID=
# The community guild modmail DMs belong to. Required only if the bot is in more
# than one guild (otherwise the single guild is used). Falls back to DEV guild.
DISCORD_GUILD_ID=

# --- Prefix / Fast Access commands ---
# Command prefix for staff/ticket/modmail commands (e.g. !claim). Default: !
PREFIX=!
# Sigil for Fast Access staff macros (e.g. $rules). Default: $  (keep it != PREFIX)
FAST_ACCESS_PREFIX=$

# --- Modmail ---
# Prefix for generated case ids (RPT-1829). Default: RPT-
MODMAIL_CASE_PREFIX=RPT-
#
# NOTE: reading DM / thread text needs the PRIVILEGED "Message Content Intent".
# Enable it for the application in the Discord Developer Portal.

# --- Staff Vacation / Break ---
# No env vars. The bot needs the "Manage Roles" permission and its highest role
# must sit ABOVE every staff / vacation role for `!break`, `!unbreak`, approvals
# and automatic expiry to apply role changes. Configure with:
#   /role vacation @role
#   /channels set type:VACATION_REQUESTS channel:#vacation-requests
#   /vacation-setup   (run in the channel that should hold the application panel)

# --- Appeal System ---
# No env vars. Users appeal via the bot's DM (no server access needed).
# The bot needs "Ban Members" to auto-unban on an accepted ban appeal, and
# "Moderate Members" / "Manage Roles" to lift timeouts / mute / jail. Configure:
#   /channels set type:APPEALS channel:#appeals
#   /role appealmanager @role   (optional — Staff Managers can always review)

# --- Gift Claim System ---
# No env vars. Gift Claim is a ticket panel: edit src/data/tickets/panels/gift-claim.ts
# (supportRoleId = your Gift Manager role, categoryId, logChannelId) then run
# /ticket-setup — it appears as a "Gift Claim" option in the main ticket menu.
# /role giftmanager @role is an optional extra grant for the case-card buttons.
# Winner records live in the `rewards` collection (no command creates them — a
# future giveaway system / admin import does).

# --- Misc ---
LOG_LEVEL=info
NODE_ENV=development
